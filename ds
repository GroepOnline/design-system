# ---------- main ----------

def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if args[0] == "list":
        cmd_list()
    elif args[0] == "build":
        cmd_build()
    else:
        c = args[0]
        sub = args[1] if len(args) > 1 else "list"
        if sub == "list":
            cmd_clist(c)
        elif sub == "select":
            cmd_select(c, args[2])
        elif sub == "add":
            path = args[2]
            kw = {}
            it = iter(args[3:])
            for a in it:
                if a == "--id": kw["eid"] = next(it)
                elif a == "--origin": kw["origin"] = next(it)
                elif a == "--source": kw["source"] = next(it)
                elif a == "--note": kw["note"] = next(it)
            cmd_add(c, path, **kw)
        elif sub == "remove":
            cmd_remove(c, args[2], yes="--yes" in args)
        else:
            err(f"onbekend: {sub}")

if __name__ == "__main__":
    main()
