def build_catalog(c):
    m = load_manifest(c)
    cells = []
    active_entry = next((e for e in m["entries"] if e["status"] == "active"), None)
    ordered = sorted(m["entries"], key=lambda e: 0 if e["status"] == "active" else 1)
    for e in ordered:
        act = e["status"] == "active"
        orgtxt = {"self": "zelf", "self-modified": "zelf (aangepast)", "external": "extern"}.get(e["origin"], e["origin"])
        if e.get("source"):
            orgtxt += f" · {e['source']}"
        fp = os.path.join(COMP, c, e["file"])
        src = ""
        if os.path.exists(fp):
            with open(fp) as f:
                src = htmlmod.escape(f.read())
        wide = ' style="grid-column:1/-1"' if e.get("wide") or e.get("h", 0) >= 600 else ""
        cells.append(CELL.format(
            cls=" active" if act else "", wide=wide,
            eid=e["id"], note=e.get("note", ""),
            orgcls="external" if e["origin"] == "external" else "",
            orgtxt=orgtxt,
            stbadge='<span class="st active">ACTIEF</span>' if act else '<span class="st locked"><svg style="width:10px;height:10px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg>vast</span>',
            file=e["file"], h=e.get("h", 240), added=e.get("added", "?"), src=src,
        ))
    ns, nx = counts(m)
    usenow = ""
    if active_entry:
        usenow = USENOW.replace("{aid}", active_entry["id"]).replace("{afile}", f"components/{c}/{active_entry['file']}")
    body = CATALOG_BODY.format(
        title=m.get("title", c), name=c, desc=m.get("desc", ""),
        icon=ICONS.get(c, "i-file"), cat=m.get("cat", "?"),
        n=len(m["entries"]), nself=ns, next=nx,
        usenow=usenow, docs=docs_html(m), cells="\n".join(cells), today=str(date.today()),
    )
    page = (SHELL_HEAD.replace("{title}", m.get("title", c))
            .replace("{nav}", nav_html(current=c))
            .replace("{sysnav}", sysnav_html())
            .replace("{mdcss}", "")
