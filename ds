  .ledger-head .replay:hover { border-color: var(--accent); }
  .ledger-rows { padding: 8px 16px 12px; }
  .lrow { display: flex; align-items: center; gap: 10px; padding: 7px 12px 7px 14px; position: relative;
    border-radius: var(--r-md); font-size: 13px; color: var(--text-muted);
