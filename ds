def build_docs():
    os.makedirs(os.path.join(ROOT, "docs"), exist_ok=True)
    cats = {}
    for src, slug, cat, desc in DOCS:
        p = os.path.join(ROOT, src)
        if not os.path.exists(p):
            print(f"  {_c('33','!')} {src} ontbreekt, overgeslagen")
            continue
        with open(p) as f:
            md = f.read()
        title = re.sub(r"\.md$", "", os.path.basename(src))
        content = md_to_html(md)
        body = DOC_PAGE_BODY.format(title=title, cat=cat, src=src, content=content, today=str(date.today()))
        with open(os.path.join(ROOT, "docs", slug + ".html"), "w") as f:
