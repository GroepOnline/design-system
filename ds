def nav_html(current=None):
    out = []
    for c in components():
        if c == "studio":
            continue
        m = load_manifest(c)
        on = " on" if c == current else ""
        acts = any(e["status"] == "active" for e in m["entries"])
        marker = '<span class="act"></span>' if acts else f'<span class="n">{len(m["entries"])}</span>'
        out.append(f'  <a class="it{on}" href="/components/{c}/">{c}{marker}</a>')
    return "\n".join(out)

def docs_html(m):
    d = m.get("docs", {})
    if not d:
        return ""
    parts = {}
    if d.get("use"):
        items = d["use"] if isinstance(d["use"], list) else [d["use"]]
        lis = "".join(f"<li>{x}</li>" for x in items)
        parts["use"] = f'<div class="doc use"><div class="dt">✓ gebruik</div><ul>{lis}</ul></div>'
    if d.get("avoid"):
        items = d["avoid"] if isinstance(d["avoid"], list) else [d["avoid"]]
        lis = "".join(f"<li>{x}</li>" for x in items)
        parts["avoid"] = f'<div class="doc avoid"><div class="dt">✕ vermijd</div><ul>{lis}</ul></div>'
    if d.get("contract"):
        items = d["contract"] if isinstance(d["contract"], list) else [d["contract"]]
        lis = "".join(f"<li><code>{x}</code></li>" for x in items)
        parts["contract"] = f'<div class="doc contract"><div class="dt">contract</div><ul>{lis}</ul></div>'
    return DOCS_CARD.format(**parts)

def build_catalog(c):
    m = load_manifest(c)
    cells = []
    for e in m["entries"]:
        act = e["status"] == "active"
        orgtxt = {"self": "zelf", "self-modified": "zelf (aangepast)", "external": "extern"}.get(e["origin"], e["origin"])
        if e.get("source"):
            orgtxt += f" · {e['source']}"
        fp = os.path.join(COMP, c, e["file"])
        src = ""
        if os.path.exists(fp):
            with open(fp) as f:
                src = htmlmod.escape(f.read())
        wide = ' style="grid-column:1/-1"' if e.get("wide") or e.get("h", 0) >= 600 else ""
        cells.append(CELL.format(
            cls=" active" if act else "",
            wide=wide,
            eid=e["id"], note=e.get("note", ""),
            orgcls="external" if e["origin"] == "external" else "",
            orgtxt=orgtxt,
            stbadge='<span class="st active">ACTIEF</span>' if act else '<span class="st locked"><svg style="width:10px;height:10px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg>vast</span>',
            file=e["file"], h=e.get("h", 240), added=e.get("added", "?"), src=src,
        ))
    body = CATALOG_BODY.format(
        title=m.get("title", c), name=c, desc=m.get("desc", ""),
        n=len(m["entries"]),
        nself=sum(1 for e in m["entries"] if e["origin"].startswith("self")),
        next=sum(1 for e in m["entries"] if e["origin"] == "external"),
        docs=docs_html(m), cells="\n".join(cells), today=str(date.today()),
    )
    page = (SHELL_HEAD.replace("{title}", m.get("title", c))
            .replace("{nav}", nav_html(current=c))
            .replace("{on_studio}", "")
            + body + SHELL_FOOT)
    with open(os.path.join(COMP, c, "index.html"), "w") as f:
        f.write(page)

def build_gallery():
    items = []
    for c in components():
        if c == "studio":
            continue
        m = load_manifest(c)
        acts = [e["id"] for e in m["entries"] if e["status"] == "active"]
        items.append(GALLERY_ITEM.format(
            name=c, title=m.get("title", c), desc=m.get("desc", ""),
            nself=sum(1 for e in m["entries"] if e["origin"].startswith("self")),
            nx=sum(1 for e in m["entries"] if e["origin"] == "external"),
            active="actief: " + ",".join(acts) if acts else "",
        ))
    body = GALLERY_BODY.format(items="\n".join(items), today=str(date.today()))
    page = (SHELL_HEAD.replace("{title}", "components")
            .replace("{nav}", nav_html())
            .replace("{on_studio}", "")
            + body + SHELL_FOOT)
    with open(os.path.join(COMP, "index.html"), "w") as f:
        f.write(page)

def cmd_build(only=None):
    if only:
        build_catalog(only)
        build_gallery()
    else:
        for c in components():
            build_catalog(c)
        build_gallery()
    print("✓ web bijgewerkt" + (f" ({only} + gallery)" if only else f" ({len(components())} componenten + gallery)"))

# ---------- main ----------

def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if args[0] == "list":
        cmd_list()
    elif args[0] == "build":
        cmd_build()
    else:
        c = args[0]
        sub = args[1] if len(args) > 1 else "list"
        if sub == "list":
            cmd_clist(c)
        elif sub == "select":
            cmd_select(c, args[2])
        elif sub == "add":
            path = args[2]
            kw = {}
            it = iter(args[3:])
            for a in it:
                if a == "--id": kw["eid"] = next(it)
                elif a == "--origin": kw["origin"] = next(it)
                elif a == "--source": kw["source"] = next(it)
                elif a == "--note": kw["note"] = next(it)
            cmd_add(c, path, **kw)
        elif sub == "remove":
            cmd_remove(c, args[2], yes="--yes" in args)
        else:
            sys.exit(f"onbekend: {sub}")

