def check_brain_wikilinks():
    """Return list of warning strings for unresolved [[wikilinks]] / issues in brain/."""
    warnings = []
    title_idx = brain_title_index()
    # duplicate basenames (Obsidian ambiguity)
    basenames = {}
    for rel in brain_note_paths():
        bn = brain_title(rel)
        basenames.setdefault(bn, []).append(rel)
    for bn, rels in sorted(basenames.items()):
        if len(rels) > 1:
            warnings.append(f"brain: duplicate note title '{bn}' → {', '.join(rels)}")
    for rel in brain_note_paths():
        raw = open(os.path.join(BRAIN, rel), encoding="utf-8").read()
        if "—" in raw:
            warnings.append(f"brain/{rel}: em-dash in copy")
        if not raw.startswith("---\n"):
            warnings.append(f"brain/{rel}: missing frontmatter")
        for m in WIKILINK_RE.finditer(raw):
            target = m.group(1).strip()
            if target in title_idx:
                continue
            if os.path.basename(target) in title_idx:
                continue
            warnings.append(f"brain/{rel}: unresolved wikilink [[{target}]]")
    return warnings

def cmd_brain_new(kind, title):
    kind = kind.lower()
    if kind not in ("decision", "research"):
        err("gebruik: ds brain new decision|research <titel>")
    folder = "Decisions" if kind == "decision" else "Research"
    tpl_name = "New Decision.md" if kind == "decision" else "New Research.md"
    tpl_path = os.path.join(BRAIN, "Templates", tpl_name)
    if not os.path.exists(tpl_path):
        err(f"template ontbreekt: brain/Templates/{tpl_name}")
    tpl = open(tpl_path, encoding="utf-8").read()
    safe = re.sub(r"[^\w\s\-]+", "", title, flags=re.UNICODE).strip()
    safe = re.sub(r"\s+", " ", safe)
    if not safe:
        err("lege titel")
    fname = f"{date.today().isoformat()} {safe}.md"
    dest = os.path.join(BRAIN, folder, fname)
