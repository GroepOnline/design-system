  .proc-card .pn { position: absolute; top: -0.12em; right: 0.4em; font-family: var(--mono); font-size: clamp(48px, 6vw, 84px); font-weight: 600; color: var(--text); opacity: 0.08; line-height: 1; pointer-events: none; letter-spacing: -0.02em; }
  .proc-card .pl { font-family: var(--mono); font-size: 12px; color: var(--accent-ink); margin-bottom: 14px; }
  .proc-card h4 { margin: 0 0 6px; font-size: 15px; font-weight: 500; }
