  .modeline .ml-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--open-green); flex-shrink: 0; animation: mlBreathe 2.4s ease-in-out infinite; }
  @keyframes mlBreathe { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }
  .modeline .ml-sec { color: var(--text-muted); }
  .modeline .ml-right { margin-left: auto; display: flex; gap: 14px; }

  /* ---- hero v3: schaalcontrast + caret ---- */
  .hero h1 { font-weight: 800; font-size: clamp(44px, 9.2vw, 120px); letter-spacing: -0.045em; }
  .hero .caret { display: inline-block; width: 0.52em; height: 0.82em; margin-left: 0.06em;
