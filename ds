def cmd_style_add(name, css_file, desc=None):
    """Voeg een nieuwe skin toe uit een :root CSS bestand.
    - default entry (id "") blijft behouden
    - duplicate id -> fout
    - body wordt netjes geindenteerd (2 spaties per regel)
    """
    if not re.fullmatch(r"[a-z][a-z0-9-]*", name):
        err(f"ongeldige skin-naam '{name}' (alleen lowercase, cijfers, streepjes)")
    raw = open(css_file).read()
    m = re.search(r':root\s*\{([^}]*)\}', raw, re.DOTALL)
    if not m:
        err(f"geen :root blok gevonden in {css_file}")
    # normaliseer: strip, indent elke declaratie-regel met 2 spaties
    lines = []
    for ln in m.group(1).strip().splitlines():
        ln = ln.strip()
        if ln and not ln.startswith("/*"):
            lines.append("  " + ln)
        elif ln:
            lines.append("  " + ln)
    body = "\n".join(lines)
    st = load_styles()
    if any(x["id"] == name for x in st):
        err(f"skin '{name}' bestaat al (id in styles.json) — kies andere naam of verwijder eerst")
    css_block = f'\n/* skin: {name} (ds style add) */\n[data-style="{name}"] {{\n{body}\n}}\n'
    with open(os.path.join(ROOT, "tokens.css"), "a") as f:
        f.write(css_block)
    st.append({"id": name, "label": name.capitalize(), "desc": desc or "custom skin"})
    save_styles(st)
    ok(f"skin '{name}' toegevoegd ({len(lines)} declaraties) — tokens.css + styles.json bijgewerkt")

def cmd_check():
    """Valideer catalogus-structuur, sprite-referenties, em-dash in copy."""
    errors = []
    warnings = []
    with open(os.path.join(COMP, "icons.svg")) as f:
        sprite_ids = set(re.findall(r'id="([^"]+)"', f.read()))
    for c in sorted(components()):
        m = load_manifest(c)
        entries = m["entries"]
        actives = [e for e in entries if e["status"] == "active"]
        if len(actives) == 0:
            errors.append(f"{c}: geen actieve variant")
        elif len(actives) > 1:
            es = ", ".join(e.get("id","?") for e in actives)
            errors.append(f"{c}: {len(actives)} actieve varianten — {es}")
        for e in entries:
            if e["status"] not in ("active", "locked"):
                errors.append(f"{c}/{e['id']}: ongeldige status '{e['status']}'")
            if e["origin"] not in ("self", "self-modified", "external"):
                errors.append(f"{c}/{e['id']}: ongeldige origin '{e['origin']}'")
            entry_dir = "self" if e.get("origin", "self") in ("self", "self-modified") else "external"
            fname = os.path.join(COMP, c, entry_dir, e["id"] + ".html")
            if not os.path.exists(fname):
                errors.append(f"{c}/{e['id']}: bestand niet gevonden ({fname})")
            src = e.get("source", "")
            if src and not src.startswith("http"):
                warnings.append(f"{c}/{e['id']}: source '{src}' is geen URL")
    # em-dash in .md files (copy)
    for fn in os.listdir(ROOT):
        if fn.endswith(".md"):
            raw = open(os.path.join(ROOT, fn)).read()
            if "—" in raw:
                warnings.append(f"em-dash in {fn}")
    # brain wikilinks (warning-only, same level as em-dash)
    warnings.extend(check_brain_wikilinks())
    for e in errors:
        errp(e)
    for w in warnings:
        wrn(w)
    ec = len(errors)
    if ec:
        err(f"{ec} errors, {len(warnings)} warnings — fix met bovenstaande")
    ok(f"{len(components())} componenten {dim(f'— {ec} errors, {len(warnings)} warnings')}")
    return ec


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if args[0] == "list":
        cmd_list()
    elif args[0] == "build":
        cmd_build()
    elif args[0] == "brain":
        cmd_brain(args[1:])
    elif args[0] == "style":
        if len(args) > 1 and args[1] == "list":
            cmd_style_list()
        elif len(args) > 2 and args[1] == "add":
            name = args[2]
            kw = {}
            it = iter(args[3:])
            for a in it:
                if a in ("--css-file", "--from"): kw["css"] = next(it)
                elif a == "--desc": kw["desc"] = next(it)
            if "css" not in kw:
                err("ds style add <naam> --css-file <file> [--desc \"...\"]")
            cmd_style_add(name, kw["css"], desc=kw.get("desc"))
        else:
            err("gebruik: ds style list | ds style add <naam> --css-file <file> [--desc \"...\"]")
    elif args[0] == "check":
        cmd_check()
    else:
        c = args[0]
        sub = args[1] if len(args) > 1 else "list"
        if sub == "list":
            cmd_clist(c)
        elif sub == "select":
            cmd_select(c, args[2])
        elif sub == "add":
            path = args[2]
            kw = {}
            it = iter(args[3:])
            for a in it:
                if a == "--id": kw["eid"] = next(it)
                elif a == "--origin": kw["origin"] = next(it)
                elif a == "--source": kw["source"] = next(it)
                elif a == "--note": kw["note"] = next(it)
            cmd_add(c, path, **kw)
        elif sub == "remove":
            cmd_remove(c, args[2], yes="--yes" in args)
        else:
            err(f"onbekend: {sub}")

if __name__ == "__main__":
    main()
