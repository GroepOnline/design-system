# ---------- cli logs (ansi) ----------

def _c(code, s):
    return f"\033[{code}m{s}\033[0m" if sys.stdout.isatty() else str(s)

def ok(m):    print(f"{_c('32;1','✓')} {m}")
def err(m):   sys.exit(f"{_c('31;1','✗')} {m}")
def wrn(m):   print(f"  {_c('33;1','!')} {m}")
def errp(m):  print(f"  {_c('31;1','✗')} {m}")
def dim(s):   return _c("2", s)
def bold(s):  return _c("1", s)
def green(s): return _c("32", s)
def green(s): return _c("32", s)
def blue(s):  return _c("34", s)
def amber(s): return _c("33", s)

# ---------- helpers ----------

def load_manifest(c):
    p = os.path.join(COMP, c, "catalog.json")
    if not os.path.exists(p):
        err(f"onbekend component: {bold(c)}")
    with open(p) as f:
        return json.load(f)

def save_manifest(c, m):
    with open(os.path.join(COMP, c, "catalog.json"), "w") as f:
        json.dump(m, f, indent=2, ensure_ascii=False)
        f.write("\n")

def components():
    return sorted(d for d in os.listdir(COMP)
                  if os.path.isdir(os.path.join(COMP, d))
                  and os.path.exists(os.path.join(COMP, d, "catalog.json")))

def rewrite_paths(text):
    text = re.sub(r'href="(?:\.\./)+tokens\.css"', 'href="/tokens.css"', text)
    text = re.sub(r'href="(?:\.\./)*components/icons\.svg#', 'href="/components/icons.svg#', text)
    text = re.sub(r'src="(?:\.\./)*components/lib\.js"', 'src="/components/lib.js"', text)
    return text

def counts(m):
    ns = sum(1 for e in m["entries"] if e["origin"].startswith("self"))
    return ns, len(m["entries"]) - ns

# ---------- commands ----------

def cmd_list():
    print(bold(f"{'component':<15} {'cat':<13} {'entries':<8} {'active':<18} {'zelf/ext'}"))
    print(dim("─" * 66))
    for c in components():
        m = load_manifest(c)
        acts = [e["id"] for e in m["entries"] if e["status"] == "active"]
        ns, nx = counts(m)
        act = green(",".join(acts)) if acts else dim("-")
        print(f"{bold(c):<24} {dim(m.get('cat','?')):<22} {len(m['entries']):<8} {act:<27} {ns}/{nx}")
