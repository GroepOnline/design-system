def brain_note_paths():
    """All .md files under brain/, relative path with / separators."""
    if not os.path.isdir(BRAIN):
        return []
    skip_tops = {".obsidian", "signals", "eval", "Attachments"}
    out = []
    for dirpath, dirs, files in os.walk(BRAIN):
        # prune non-note dirs
        rel_dir = os.path.relpath(dirpath, BRAIN)
        top = rel_dir.split(os.sep)[0] if rel_dir != "." else ""
        if top in skip_tops:
            dirs.clear()
            continue
        dirs[:] = [d for d in dirs if d not in skip_tops and d != ".obsidian"]
        for fn in files:
            if not fn.endswith(".md"):
                continue
            abs_p = os.path.join(dirpath, fn)
            rel = os.path.relpath(abs_p, BRAIN).replace(os.sep, "/")
            out.append(rel)
    return sorted(out)

def brain_slug(rel):
    base = os.path.splitext(rel)[0]
    return re.sub(r"[^a-zA-Z0-9]+", "-", base).strip("-").lower() or "note"

def brain_title(rel):
    return os.path.splitext(os.path.basename(rel))[0]

def brain_title_index():
    """Obsidian-style: note basename (without .md) → slug. Last wins on collision."""
    idx = {}
    for rel in brain_note_paths():
        idx[brain_title(rel)] = brain_slug(rel)
        # also allow path-without-ext for [[Indexes/Taste]] style
        idx[os.path.splitext(rel)[0]] = brain_slug(rel)
    return idx

def brain_strip_frontmatter(md):
    if md.startswith("---\n"):
        end = md.find("\n---\n", 4)
        if end != -1:
            return md[end + 5:]
    return md

def brain_rewrite_wikilinks(md, title_idx):
    def repl(m):
        target = m.group(1).strip()
        alias = (m.group(2) or target).strip()
        slug = title_idx.get(target)
        if not slug:
            # try basename of path-like target
            slug = title_idx.get(os.path.basename(target))
        if slug:
            return f"[{alias}](./{slug}.html)"
        return alias
    return WIKILINK_RE.sub(repl, md)

