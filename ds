  .ruler .rl { position: absolute; opacity: 0.7; letter-spacing: 0.02em; }
  .ruler-x .rl { top: 2px; transform: translateX(3px); }
  .ruler-y .rl { left: 1px; transform: translateY(-4px); }
  .cropmark { position: fixed; width: 14px; height: 14px; z-index: 60; pointer-events: none; }
  .cropmark::before, .cropmark::after { content: ""; position: absolute; background: var(--line-strong); }
  .cropmark::before { width: 14px; height: 1px; }
  .cropmark::after { width: 1px; height: 14px; }
  .cropmark.tl { top: 62px; left: 26px; }
  .cropmark.tr { top: 62px; right: 8px; transform: scaleX(-1); }
  .cropmark.bl { bottom: 36px; left: 26px; transform: scaleY(-1); }
  .cropmark.br { bottom: 36px; right: 8px; transform: scale(-1); }
  .titelblok { position: fixed; right: 10px; bottom: 38px; z-index: 60; pointer-events: none;
    border: 1px solid var(--line-strong); background: var(--bg); padding: 7px 10px;
