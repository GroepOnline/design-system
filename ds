#!/usr/bin/env python3
"""ds — design-system catalogus CLI

Model:
  components/<naam>/
    catalog.json      manifest (entries: id, file, origin, source, status, added, note)
    self/             zelf-ontworpen varianten (ook aangepaste externe)
    external/         externe varianten (shadcn, devin-observed, ...)
    index.html        GEGENEREERD door `ds build` — niet handmatig bewerken

Statussen:
  active   het geselecteerde component (1 per component)
  locked   in de catalogus, vast — verandert nooit stilletjes

Experimenten horen in playground/. Promoveren: ds <c> add.
Selecteren:      ds <c> select <id>   (demote huidige active automatisch)
Verwijderen:     ds <c> remove <id>   (expliciet)
"""
import json
import os
import re
import shutil
import sys
from datetime import date

ROOT = os.path.dirname(os.path.abspath(__file__))
COMP = os.path.join(ROOT, "components")

# ---------- helpers ----------

def load_manifest(c):
    p = os.path.join(COMP, c, "catalog.json")
    if not os.path.exists(p):
        sys.exit(f"onbekend component: {c}")
    with open(p) as f:
        return json.load(f)

def save_manifest(c, m):
    p = os.path.join(COMP, c, "catalog.json")
    with open(p, "w") as f:
        json.dump(m, f, indent=2, ensure_ascii=False)
        f.write("\n")

def components():
    return sorted(d for d in os.listdir(COMP)
                  if os.path.isdir(os.path.join(COMP, d))
                  and os.path.exists(os.path.join(COMP, d, "catalog.json")))

def rewrite_paths(text):
    """Maak paden root-absoluut zodat varianten overal staan."""
    text = re.sub(r'href="(?:\.\./)+tokens\.css"', 'href="/tokens.css"', text)
    text = re.sub(r'href="(?:\.\./)*components/icons\.svg#', 'href="/components/icons.svg#', text)
    text = re.sub(r'src="(?:\.\./)*components/lib\.js"', 'src="/components/lib.js"', text)
    return text

# ---------- commands ----------

def cmd_list():
    print(f"{'component':<14} {'entries':<8} {'active':<20} {'self/ext'}")
    for c in components():
        m = load_manifest(c)
        acts = [e["id"] for e in m["entries"] if e["status"] == "active"]
        ns = sum(1 for e in m["entries"] if e["origin"].startswith("self"))
        nx = len(m["entries"]) - ns
        print(f"{c:<14} {len(m['entries']):<8} {','.join(acts) or '-':<20} {ns}/{nx}")

def cmd_clist(c):
    m = load_manifest(c)
    print(f"{m.get('title', c)} — {m.get('desc','')}\n")
    print(f"{'status':<8} {'origin':<14} {'id':<22} {'source':<14} note")
    for e in m["entries"]:
        st = "ACTIEF" if e["status"] == "active" else "vast"
        print(f"{st:<8} {e['origin']:<14} {e['id']:<22} {(e.get('source') or '-'):<14} {e.get('note','')}")

def cmd_select(c, eid):
    m = load_manifest(c)
    ids = [e["id"] for e in m["entries"]]
    if eid not in ids:
        sys.exit(f"onbekende entry: {eid} (opties: {', '.join(ids)})")
    for e in m["entries"]:
        e["status"] = "active" if e["id"] == eid else "locked"
    save_manifest(c, m)
    cmd_build(only=c)
    print(f"✓ {c}/{eid} is nu ACTIEF (rest vast). Web bijgewerkt.")

def cmd_add(c, path, eid=None, origin="self", source=None, note=""):
    if origin not in ("self", "self-modified", "external"):
        sys.exit("origin: self | self-modified | external")
    m = load_manifest(c)
    eid = eid or re.sub(r"[^a-z0-9-]", "-", os.path.splitext(os.path.basename(path))[0].lower())
    if any(e["id"] == eid for e in m["entries"]):
        sys.exit(f"entry bestaat al: {eid} (kies andere id of verwijder eerst)")
    dest_dir = os.path.join(COMP, c, "external" if origin == "external" else "self")
    os.makedirs(dest_dir, exist_ok=True)
    dest = os.path.join(dest_dir, eid + ".html")
    if os.path.exists(dest):
        sys.exit(f"bestand bestaat al: {dest} — catalogus is vast; verwijderen kan alleen expliciet")
    with open(path) as f:
        content = rewrite_paths(f.read())
    with open(dest, "w") as f:
        f.write(content)
    m["entries"].append({
        "id": eid, "file": os.path.relpath(dest, os.path.join(COMP, c)),
        "origin": origin, "source": source, "status": "locked",
        "added": str(date.today()), "note": note,
    })
    save_manifest(c, m)
    cmd_build(only=c)
    print(f"✓ {c}/{eid} toegevoegd als VAST ({origin}). Selecteer met: ./ds {c} select {eid}")

def cmd_remove(c, eid, yes=False):
    m = load_manifest(c)
    entry = next((e for e in m["entries"] if e["id"] == eid), None)
    if not entry:
        sys.exit(f"onbekende entry: {eid}")
    if entry["status"] == "active" and not yes:
        sys.exit(f"{eid} is ACTIEF — bevestig met --yes (selecteer daarna een andere)")
    m["entries"] = [e for e in m["entries"] if e["id"] != eid]
    f = os.path.join(COMP, c, entry["file"])
    if os.path.exists(f):
        os.remove(f)
    save_manifest(c, m)
    cmd_build(only=c)
    print(f"✓ {c}/{eid} verwijderd uit catalogus")

