  .lrow.in { opacity: 1; transform: none; }
  .lrow::before { content: ""; position: absolute; left: 0; top: 7px; bottom: 7px; width: 2px; border-radius: 1px;
    background: var(--line-strong); transition: background 0.4s; }
  .lrow.live::before { background: var(--accent); }
  .lrow.live { box-shadow: var(--glow-live); animation: lrowBreathe var(--dur-pulse-cycle) ease-in-out infinite; color: var(--text); }
  @keyframes lrowBreathe { 0%, 100% { box-shadow: var(--glow-live); } 50% { box-shadow: 0 0 0 1px color-mix(in srgb, var(--open-green) 55%, transparent), 0 0 18px 5px color-mix(in srgb, var(--open-green) 45%, transparent); } }
  .lrow .lname { font-weight: 500; color: var(--text); }
  .lrow .ltimer { font-family: var(--mono); font-size: 12px; font-variant-numeric: tabular-nums; }
  .lrow .ltools { margin-left: auto; display: flex; gap: 4px; align-items: center; }
  .lrow .ldiff { font-family: var(--mono); font-size: 11.5px; font-variant-numeric: tabular-nums; display: none; }
  .lrow.done .ldiff { display: inline; }
  .lrow.done { filter: saturate(0.85); }
  .lrow .ldiff .add { color: var(--open-green); }
  .lrow .ldiff .del { color: var(--red); }
  .lrow .lstep { font-family: var(--mono); font-size: 11px; color: var(--text-faint); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 34vw; }
  .lripple { width: 18px; height: 10px; position: relative; }
  .lripple::before { content: ""; position: absolute; left: 0; right: 0; top: 4px; height: 2px; background: currentColor; border-radius: 1px; opacity: 0.35; }
  .lripple.go::before { animation: rippleflow 1.1s var(--ease-out) 1; opacity: 0.9; }
  .lripple.r { color: var(--accent); } .lripple.w { color: var(--open-green); } .lripple.x { color: var(--amber); }
  @keyframes rippleflow { 0% { transform: scaleX(0.15); transform-origin: left; } 45% { transform: scaleX(1); transform-origin: left; } 46% { transform-origin: right; } 100% { transform: scaleX(0.15); transform-origin: right; } }

  /* ---- band: thema-aware (geen geforceerd vlak) ---- */

  /* ---- spring overal waar het voelbaar moet zijn ---- */
  .comp-card, .stat { transition: border-color var(--dur-fast), transform 480ms var(--spring); }

  /* ---- reveal ---- */
  .reveal { opacity: 0; transform: translateY(14px); transition: opacity 320ms var(--ease-out), transform 480ms var(--spring); }
