  .footer .wrap { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; border-top: 1px solid var(--line); padding-top: 24px; }

  /* ---- blad-chrome: de pagina als technische tekening ---- */
  body { padding-bottom: 30px; }
  .ruler { position: fixed; z-index: 60; pointer-events: none; background: var(--bg); font-family: var(--mono); font-size: 9px; color: var(--text-faint); }
  .ruler-x { top: 56px; left: 0; right: 0; height: 18px; border-bottom: 1px solid var(--line);
    background-image: repeating-linear-gradient(90deg, var(--line-strong) 0 1px, transparent 1px 40px),
                      repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px 8px);
    background-position: 0 100%, 0 100%; background-size: 100% 10px, 100% 5px; background-repeat: no-repeat; }
  .ruler-y { top: 56px; left: 0; bottom: 30px; width: 20px; border-right: 1px solid var(--line);
    background-image: repeating-linear-gradient(0deg, var(--line-strong) 0 1px, transparent 1px 40px),
