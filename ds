    font-family: var(--mono); font-size: 11.5px; color: var(--text-muted); }
  .ledger-head .lh-live { width: 7px; height: 7px; border-radius: 50%; background: var(--open-green); align-self: center; animation: mlBreathe 2.4s ease-in-out infinite; }
