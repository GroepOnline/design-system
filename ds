  .titelblok b { color: var(--text-muted); font-weight: 500; }
  .modeline { position: fixed; left: 0; right: 0; bottom: 0; height: 30px; z-index: 70;
    display: flex; align-items: center; gap: 14px; padding: 0 12px 0 26px;
    border-top: 1px solid var(--line); background: var(--bg);
