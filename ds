# ---------- cli logs (ansi) ----------

def _c(code, s):
    return f"\033[{code}m{s}\033[0m" if sys.stdout.isatty() else str(s)

def ok(m):    print(f"{_c('32;1','✓')} {m}")
def err(m):   sys.exit(f"{_c('31;1','✗')} {m}")
def dim(s):   return _c("2", s)
def bold(s):  return _c("1", s)
def green(s): return _c("32", s)
def blue(s):  return _c("34", s)
def amber(s): return _c("33", s)

# ---------- helpers ----------

def load_manifest(c):
    p = os.path.join(COMP, c, "catalog.json")
    if not os.path.exists(p):
        err(f"onbekend component: {bold(c)}")
    with open(p) as f:
        return json.load(f)

def save_manifest(c, m):
    with open(os.path.join(COMP, c, "catalog.json"), "w") as f:
        json.dump(m, f, indent=2, ensure_ascii=False)
        f.write("\n")

def components():
    return sorted(d for d in os.listdir(COMP)
                  if os.path.isdir(os.path.join(COMP, d))
                  and os.path.exists(os.path.join(COMP, d, "catalog.json")))

def rewrite_paths(text):
    text = re.sub(r'href="(?:\.\./)+tokens\.css"', 'href="/tokens.css"', text)
    text = re.sub(r'href="(?:\.\./)*components/icons\.svg#', 'href="/components/icons.svg#', text)
    text = re.sub(r'src="(?:\.\./)*components/lib\.js"', 'src="/components/lib.js"', text)
    return text

def counts(m):
    ns = sum(1 for e in m["entries"] if e["origin"].startswith("self"))
    return ns, len(m["entries"]) - ns

# ---------- commands ----------

def cmd_list():
    print(bold(f"{'component':<15} {'cat':<13} {'entries':<8} {'active':<18} {'zelf/ext'}"))
    print(dim("─" * 66))
    for c in components():
        m = load_manifest(c)
        acts = [e["id"] for e in m["entries"] if e["status"] == "active"]
        ns, nx = counts(m)
        act = green(",".join(acts)) if acts else dim("-")
        print(f"{bold(c):<24} {dim(m.get('cat','?')):<22} {len(m['entries']):<8} {act:<27} {ns}/{nx}")
    tot = sum(len(load_manifest(c)["entries"]) for c in components())
    print(dim("─" * 66))
    print(f"{len(components())} componenten, {tot} varianten " + dim("· ./ds <component> list voor detail"))

def cmd_clist(c):
    m = load_manifest(c)
    print(f"{bold(m.get('title', c))} {dim('· ' + m.get('cat','?'))} — {m.get('desc','')}")
    d = m.get("docs", {})
    if d.get("use"):   print(f"  {green('✓ gebruik')}  " + dim("; ".join(d["use"])))
    if d.get("avoid"): print(f"  {_c('31','✕ vermijd')}  " + dim("; ".join(d["avoid"])))
    print()
    print(dim(f"{'status':<9} {'origin':<15} {'id':<22} {'source':<15} note"))
    for e in m["entries"]:
        st = green("ACTIEF") if e["status"] == "active" else dim("vast")
        print(f"{st:<18} {e['origin']:<15} {bold(e['id']):<31} {dim((e.get('source') or '-')):<24} {e.get('note','')}")

def cmd_select(c, eid):
    m = load_manifest(c)
    ids = [e["id"] for e in m["entries"]]
    if eid not in ids:
        err(f"onbekende entry: {bold(eid)} " + dim(f"(opties: {', '.join(ids)})"))
    for e in m["entries"]:
        e["status"] = "active" if e["id"] == eid else "locked"
    save_manifest(c, m)
    cmd_build(only=c)
    ok(f"{bold(c)}/{green(eid)} is nu ACTIEF (rest vast). Web bijgewerkt.")

def cmd_add(c, path, eid=None, origin="self", source=None, note=""):
    if origin not in ("self", "self-modified", "external"):
        err("origin: self | self-modified | external")
    m = load_manifest(c)
    eid = eid or re.sub(r"[^a-z0-9-]", "-", os.path.splitext(os.path.basename(path))[0].lower())
    if any(e["id"] == eid for e in m["entries"]):
        err(f"entry bestaat al: {bold(eid)} " + dim("(kies andere id of verwijder eerst)"))
    dest_dir = os.path.join(COMP, c, "external" if origin == "external" else "self")
    os.makedirs(dest_dir, exist_ok=True)
    dest = os.path.join(dest_dir, eid + ".html")
    if os.path.exists(dest):
        err(f"bestand bestaat al: {dest} " + dim("— catalogus is vast; verwijderen kan alleen expliciet"))
    with open(path) as f:
        content = rewrite_paths(f.read())
    with open(dest, "w") as f:
        f.write(content)
    m["entries"].append({
        "id": eid, "file": os.path.relpath(dest, os.path.join(COMP, c)),
        "origin": origin, "source": source, "status": "locked",
        "added": str(date.today()), "note": note,
    })
    save_manifest(c, m)
    cmd_build(only=c)
    ok(f"{bold(c)}/{eid} toegevoegd als VAST ({origin}). Selecteer: {dim('./ds ' + c + ' select ' + eid)}")

def cmd_remove(c, eid, yes=False):
    m = load_manifest(c)
    entry = next((e for e in m["entries"] if e["id"] == eid), None)
    if not entry:
        err(f"onbekende entry: {bold(eid)}")
    if entry["status"] == "active" and not yes:
        err(f"{bold(eid)} is ACTIEF — bevestig met {amber('--yes')} (selecteer daarna een andere)")
    m["entries"] = [e for e in m["entries"] if e["id"] != eid]
    f = os.path.join(COMP, c, entry["file"])
    if os.path.exists(f):
        os.remove(f)
    save_manifest(c, m)
    cmd_build(only=c)
    ok(f"{bold(c)}/{eid} verwijderd uit catalogus")

# ---------- markdown renderer (geen deps) ----------

def _inline(t):
    t = htmlmod.escape(t)
    t = re.sub(r"`([^`]+)`", r"<code>\1</code>", t)
    t = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", t)
    t = re.sub(r"\*([^*]+)\*", r"<em>\1</em>", t)
    t = re.sub(r"\[([^\]]+)\]\(([^)]+)\)", r'<a href="\2">\1</a>', t)
    return t

def md_to_html(md):
    lines, out, i = md.split("\n"), [], 0
    in_code, lang, buf, lst = False, "", [], None
    while i < len(lines):
        line = lines[i]
        s = line.strip()
        if s.startswith("```"):
            if not in_code:
                in_code, lang, buf = True, s[3:], []
            else:
                in_code = False
                out.append(f'<pre><code>{htmlmod.escape(chr(10).join(buf))}</code></pre>')
            i += 1; continue
        if in_code:
            buf.append(line); i += 1; continue
        if not s:
            if lst: out.append(f"</{lst}>"); lst = None
            i += 1; continue
        if s.startswith("|") and i + 1 < len(lines) and re.match(r"^\|[\s:|\-]+\|?$", lines[i+1].strip()):
            header = [c.strip() for c in s.strip("|").split("|")]
            i += 2; rows = []
            while i < len(lines) and lines[i].strip().startswith("|"):
                rows.append([c.strip() for c in lines[i].strip().strip("|").split("|")]); i += 1
            h = "<table><thead><tr>" + "".join(f"<th>{_inline(c)}</th>" for c in header) + "</tr></thead><tbody>"
            for r in rows:
                h += "<tr>" + "".join(f"<td>{_inline(c)}</td>" for c in r) + "</tr>"
            out.append(h + "</tbody></table>"); continue
        m = re.match(r"^(#{1,4})\s+(.*)", s)
        if m:
            out.append(f"<h{len(m.group(1))}>{_inline(m.group(2))}</h{len(m.group(1))}>")
            i += 1; continue
        if re.match(r"^(-{3,}|\*{3,})$", s):
            out.append("<hr>"); i += 1; continue
        if s.startswith(">"):
            out.append(f"<blockquote>{_inline(s.lstrip('> ').strip())}</blockquote>"); i += 1; continue
        m = re.match(r"^[-*]\s+(.*)", s)
        if m:
            if lst != "ul":
                if lst: out.append(f"</{lst}>")
                out.append("<ul>"); lst = "ul"
            out.append(f"<li>{_inline(m.group(1))}</li>"); i += 1; continue
        m = re.match(r"^\d+[.)]\s+(.*)", s)
        if m:
            if lst != "ol":
                if lst: out.append(f"</{lst}>")
                out.append("<ol>"); lst = "ol"
            out.append(f"<li>{_inline(m.group(1))}</li>"); i += 1; continue
        out.append(f"<p>{_inline(s)}</p>"); i += 1
    if lst: out.append(f"</{lst}>")
    return "\n".join(out)

