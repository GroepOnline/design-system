def cmd_build(only=None):
    targets = [only] if only else components()
    for c in targets:
        build_catalog(c)
        m = load_manifest(c)
        ns, nx = counts(m)
        print(f"  {_c('32','✓')} {bold(c):<14} {len(m['entries'])} varianten {dim(f'({ns} zelf, {nx} extern)')}")
    build_gallery()
    if only:
        ok(f"web bijgewerkt {dim('(' + only + ' + gallery)')}")
    else:
        build_docs()
        build_taste()
